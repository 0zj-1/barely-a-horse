{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "barely-a-horse",
  "main": "./server/src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "binding": "ASSETS",
    // The client is a single-page app; only the game API and sockets hit the Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "observability": { "enabled": true }
}
